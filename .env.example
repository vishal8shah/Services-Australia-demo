# Copy to .env and source it, or export these in your shell.
#   cp .env.example .env && edit && set -a && . ./.env && set +a
# Then check it with: make doctor

# ---- one key is enough. Pick the provider you have. ----

# With a Claude key. Anthropic has no embeddings endpoint, which does not matter:
# query expansion is what bridges a person's wording to the vocabulary of the
# pages, and it does that better than embeddings do. Leave embeddings on the
# offline default.
ANTHROPIC_API_KEY=sk-ant-...
SAAL_LLM_PROVIDER=anthropic
SAAL_EXPANDER=anthropic

# With an OpenAI key, same two roles plus embeddings if you want them.
# OPENAI_API_KEY=sk-...
# SAAL_LLM_PROVIDER=openai
# SAAL_EXPANDER=openai
# SAAL_EMBED_PROVIDER=openai       # optional, rerun `make index` after changing it

# With both: Claude writes the answers, OpenAI does the embeddings.
# SAAL_LLM_PROVIDER=anthropic
# SAAL_EXPANDER=anthropic
# SAAL_EMBED_PROVIDER=openai

# ---- optional, all have working defaults ----
# Model names get retired. Check what your key can see with:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# SAAL_MODEL=claude-sonnet-5                   # synthesis
# SAAL_FAST_MODEL=claude-haiku-4-5-20251001    # expansion and the eval judge
# SAAL_OPENAI_EMBED_MODEL=text-embedding-3-small
# SAAL_OPENAI_EMBED_DIMS=512          # cosine is pure Python, dimensions are latency

# SAAL_SCORE_FLOOR=0.30               # below this the answer is refused
# SAAL_DEMO_MODE=static               # replay recorded answers, no live model calls
# SAAL_RECORD=1                       # record live answers into evals/fixtures/llm.json

