# Copy to .env and source it, or export these in your shell.
#   cp .env.example .env && edit && set -a && . ./.env && set +a
# Then check it with: make doctor

# ---- the one key this project needs ----
OPENAI_API_KEY=sk-...

# Use it for all three roles. Synthesis writes the answer, expansion rewrites the
# question into the vocabulary the pages use, embeddings make retrieval semantic.
SAAL_LLM_PROVIDER=openai
SAAL_EXPANDER=openai
SAAL_EMBED_PROVIDER=openai

# ---- optional, all have working defaults ----
# Model names get retired. Check what your key can see with:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# SAAL_MODEL=gpt-4o-mini              # synthesis
# SAAL_FAST_MODEL=gpt-4o-mini         # expansion and the eval judge
# SAAL_OPENAI_EMBED_MODEL=text-embedding-3-small
# SAAL_OPENAI_EMBED_DIMS=512          # cosine is pure Python, dimensions are latency

# SAAL_SCORE_FLOOR=0.30               # below this the answer is refused
# SAAL_DEMO_MODE=static               # replay recorded answers, no live model calls
# SAAL_RECORD=1                       # record live answers into evals/fixtures/llm.json

# Anthropic instead of, or alongside, OpenAI
# ANTHROPIC_API_KEY=sk-ant-...
